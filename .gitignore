# Only the files listed below are part of the repository. Everything else in this folder
# (simulation data, caches, models, slide generators, drafts) stays local.
/*
!/.gitignore
!/README.md
!/requirements.txt

# shared model
!/maxmap_model.py
# Case 1: 1D rods
!/rod_flux_sim.py
!/rod_flux_experiment.py
!/rod1d_sim.py
!/rod1d_experiment.py
!/rod1d_allparams.py
# Case 2: single bead
!/maxmap_data.py
!/maxmap_analyze.py
!/maxmap_train.py
!/bead2_data.py
!/bead2_train.py
!/bead2_hybrid.py
!/bead2_best_model.py
!/bead_model.py
!/bead_data.py
# Case 3: geometry
!/tts_data.py
!/tts_analyze.py
!/tts_model.py
# earlier study: wall dataset
!/wall_data.py
!/baselines.py
!/diffusion_compare.py

# results summaries
!/rodflux_outputs/
/rodflux_outputs/*
!/rodflux_outputs/summary.json
!/rod1d_outputs/
/rod1d_outputs/*
!/rod1d_outputs/rod1d_summary.json
!/rod1d_outputs/rod1d_allparams.json
!/maxmap_outputs/
/maxmap_outputs/*
